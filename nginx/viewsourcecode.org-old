server {
	listen 80;
	listen 443 ssl;
	ssl_certificate /etc/letsencrypt/live/viewsourcecode.org/fullchain.pem;
	ssl_certificate_key /etc/letsencrypt/live/viewsourcecode.org/privkey.pem;
	include /etc/letsencrypt/options-ssl-nginx.conf;
	ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
	server_name www.viewsourcecode.org;
	return 301 https://viewsourcecode.org$request_uri;
}

server {
	root /srv/www/viewsourcecode.org;

	index index.php index.html index.htm;

	server_name viewsourcecode.org;

	location / {
		try_files $uri $uri/ =404;
	}

	location ~ \.php$ {
		include snippets/fastcgi-php.conf;
		fastcgi_pass unix:/run/php/php7.0-fpm.sock;
	}

	location ~ /\.ht {
		deny all;
	}

    listen 80; # managed by Certbot

    listen 443 ssl; # managed by Certbot
ssl_certificate /etc/letsencrypt/live/viewsourcecode.org/fullchain.pem; # managed by Certbot
ssl_certificate_key /etc/letsencrypt/live/viewsourcecode.org/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot



    if ($scheme != "https") {
        return 301 https://viewsourcecode.org$request_uri;
    } # managed by Certbot


    # Redirect non-https traffic to https
    # if ($scheme != "https") {
    #     return 301 https://viewsourcecode.org$request_uri;
    # } # managed by Certbot

}

