server {
    server_name www.buskatoon.ca;
    listen 443 ssl;
    listen [::]:443 ssl;
    ssl_certificate /etc/letsencrypt/live/buskatoon.ca/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/buskatoon.ca/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    return 301 https://buskatoon.ca$request_uri;
}

server {
    server_name buskatoon.ca;

    root /var/www/buskatoon.ca;
    index index.html;

    location / {
        add_header Access-Control-Allow-Origin *;
        try_files $uri $uri/ =404;
    }

    listen 443 ssl; # managed by Certbot
    listen [::]:443 ssl ipv6only=on; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/buskatoon.ca/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/buskatoon.ca/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
    server_name buskatoon.ca;

    listen 80;
    listen [::]:80;

    if ($host = buskatoon.ca) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    return 404; # managed by Certbot
}

server {
    server_name www.buskatoon.ca;

    listen 80;
    listen [::]:80;

    if ($host = www.buskatoon.ca) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    return 404; # managed by Certbot
}
